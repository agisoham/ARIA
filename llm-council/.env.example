# Copy this file to .env and fill in your own keys. All free tiers — no credit card required.
# NEVER commit the real .env (the .gitignore already excludes it).

GITHUB_TOKEN=            # github.com → Settings → Developer settings → Fine-grained PAT with models:read
GOOGLE_API_KEY=          # aistudio.google.com → Get API key
GROQ_API_KEY=            # optional — console.groq.com
CEREBRAS_API_KEY=        # optional — cloud.cerebras.ai

